# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in values for your environment.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_agent
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# WhatsApp Cloud API Configuration
# Meta App Dashboard -> WhatsApp -> API Setup & Webhooks
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_API_VERSION=v21.0

# WhatsApp transport: meta (Cloud API direct) or ycloud
WHATSAPP_PROVIDER=meta
# YCloud: Dashboard -> Developers -> API Keys / Webhooks. Webhook URL: POST /webhook
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=
YCLOUD_WEBHOOK_SECRET=

# AI Provider Configuration
# Supported providers: openai, groq, gemini, stub (for offline testing/dev)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
# OpenRouter free models (tool-calling verified): AI_PROVIDER=openai, AI_BASE_URL=https://openrouter.ai/api/v1,
#   AI_API_KEY=sk-or-v1-..., AI_MODEL=poolside/laguna-s-2.1:free (or nvidia/nemotron-3-ultra-550b-a55b:free).
#   The agent needs tool support: pick models whose supported_parameters include "tools". Free models are
#   rate limited and change often; the engine retries 429s with a long backoff.
# Optional base URL for OpenAI-compatible gateways (e.g. Groq, OpenRouter, Google Gemini)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000

# Agent Task Engine (see README "Agent Task Engine")
AGENT_WORKER_ENABLED=true
AGENT_POLL_INTERVAL_MS=2000
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_TOOL_CALLS_PER_ROUND=4
AGENT_MODEL_TIMEOUT_MS=60000
AGENT_TASK_TIMEOUT_MS=120000
AGENT_MAX_TOOL_OUTPUT_CHARS=4000
AGENT_MAX_REQUEST_CHARS=4000
AGENT_MAX_RESPONSE_CHARS=4000
AGENT_MAX_ATTEMPTS=3
AGENT_LEASE_SECONDS=60
AGENT_HISTORY_LIMIT=20
AGENT_CONFIRMATION_TTL_MINUTES=30
# Comma-separated permissions granted to every fully verified user
AGENT_DEFAULT_PERMISSIONS=utility:read,reminders:read,reminders:write,web:search

# Reminders & Scheduling (see README "Reminders and Scheduling")
REMINDER_WORKER_ENABLED=true
# 'whatsapp' = official WhatsApp Business Platform. 'mock' NEVER contacts WhatsApp (dev/tests only;
# rejected in production). Defaults: whatsapp in production, mock elsewhere.
REMINDER_PROVIDER=mock
REMINDER_POLL_INTERVAL_MS=5000
REMINDER_BATCH_SIZE=10
REMINDER_LEASE_SECONDS=120
REMINDER_MAX_ATTEMPTS=5
REMINDER_SEND_TIMEOUT_MS=15000
REMINDER_MAX_TITLE_CHARS=500
REMINDER_MAX_HORIZON_DAYS=365
REMINDER_MIN_LEAD_SECONDS=5
REMINDER_MAX_ACTIVE_PER_USER=100
REMINDER_MAX_CREATES_PER_HOUR=30
REMINDER_CONFIRM_BEYOND_DAYS=30
REMINDER_RATE_LIMIT_WINDOW_MS=60000
REMINDER_RATE_LIMIT_MAX=20
# Approved WhatsApp template with ONE body variable {{1}} (the reminder text). Required to deliver
# reminders outside the 24-hour customer-service window.
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANG=en

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Optional allowed CORS origins (comma-separated, e.g. https://dashboard.yourdomain.com)
CORS_ALLOWED_ORIGINS=

# --- Browser automation (Phase 1) ---
# Off by default. To use it: npm run browser:install, set BROWSER_ENABLED=true, and add `browser:*`
# (or browser:read,browser:write) to AGENT_DEFAULT_PERMISSIONS.
BROWSER_ENABLED=false
# Required to store website sign-ins (connections). Generate: npm run browser:genkey
BROWSER_ENCRYPTION_KEY=
BROWSER_HEADLESS=true
BROWSER_MAX_SESSIONS=3
BROWSER_MAX_SESSIONS_PER_USER=1
BROWSER_MAX_STEPS=40
BROWSER_MAX_NAVIGATIONS=15
BROWSER_MAX_RUN_SECONDS=300
BROWSER_IDLE_TIMEOUT_SECONDS=120
BROWSER_NAV_TIMEOUT_MS=20000
BROWSER_ACTION_TIMEOUT_MS=8000
BROWSER_MAX_TEXT_CHARS=4000
BROWSER_MAX_ELEMENTS=60
# Optional host allowlist / blocklist (comma separated; subdomains included). Empty allowlist = any public host.
BROWSER_ALLOWED_DOMAINS=
BROWSER_BLOCKED_DOMAINS=
# Block POST/PUT/PATCH/DELETE from pages unless a user-confirmed action is running. Keep true.
BROWSER_BLOCK_UNCONFIRMED_MUTATIONS=true
# DEV/TEST ONLY: allow localhost/private targets. Refused in production.
BROWSER_ALLOW_PRIVATE_NETWORK=false

# --- Browser sign-in handoff (Phase 2) ---
# Lets the user sign in / pass MFA / solve a CAPTCHA from their own device. Needs BROWSER_ENABLED=true,
# BROWSER_ENCRYPTION_KEY, and a PUBLIC https URL that reaches this server (see docs/remote-browser-handoff.md).
BROWSER_HANDOFF_ENABLED=false
PUBLIC_BASE_URL=
BROWSER_HANDOFF_LINK_TTL_MINUTES=10
BROWSER_HANDOFF_SESSION_MINUTES=10
BROWSER_HANDOFF_IDLE_SECONDS=120
BROWSER_HANDOFF_MAX_PER_HOUR=5
# Identity providers a sign-in may pass through (comma separated, explicit allowlist only), e.g. accounts.google.com
BROWSER_HANDOFF_EXTRA_HOSTS=
# Number of reverse proxies in front of the app (ngrok/nginx/Cloudflare = 1). Needed for correct IPs and HTTPS.
TRUST_PROXY=0

# --- Gmail Integration (Phase 3) ---
# Direct Google OAuth 2.0 and Gmail API integration.
# When enabled, the agent engine uses official Gmail API tools over browser automation for email tasks.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
# 32-byte base64 encryption key for refresh tokens at rest. Generate: npm run browser:genkey
GMAIL_ENCRYPTION_KEY=

# --- Workflow Memory (Phase 4) ---
# Persistent user-approved preferences, workflows, facts, and project context across conversations.
MEMORY_ENABLED=true
MEMORY_MAX_RETRIEVED=5
MEMORY_MAX_CONTEXT_CHARS=2500
MEMORY_DEFAULT_EXPIRY_DAYS=0

# --- Web search (web_search tool) ---
# none | tavily | brave | searxng. tavily/brave need WEB_SEARCH_API_KEY (free tiers exist: check their sites for current limits).
# searxng is self-hosted and free: set WEB_SEARCH_URL and enable json under search.formats in its settings.yml.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
WEB_SEARCH_URL= 
WEB_SEARCH_MAX_RESULTS=5
# Searches per user per UTC day (protects a free quota). 0 = unlimited.
WEB_SEARCH_DAILY_LIMIT_PER_USER=20
    