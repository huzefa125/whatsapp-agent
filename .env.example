# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in values for your environment.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_agent
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# WhatsApp Cloud API Configuration
# Meta App Dashboard -> WhatsApp -> API Setup & Webhooks
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_API_VERSION=v21.0

# AI Provider Configuration
# Supported providers: openai, groq, gemini, stub (for offline testing/dev)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
# Optional base URL for OpenAI-compatible gateways (e.g. Groq, OpenRouter, Google Gemini)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# Agent Task Engine (see README "Agent Task Engine")
AGENT_WORKER_ENABLED=true
AGENT_POLL_INTERVAL_MS=2000
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_TOOL_CALLS_PER_ROUND=4
AGENT_MODEL_TIMEOUT_MS=30000
AGENT_TASK_TIMEOUT_MS=120000
AGENT_MAX_TOOL_OUTPUT_CHARS=4000
AGENT_MAX_REQUEST_CHARS=4000
AGENT_MAX_RESPONSE_CHARS=4000
AGENT_MAX_ATTEMPTS=3
AGENT_LEASE_SECONDS=60
AGENT_HISTORY_LIMIT=20
AGENT_CONFIRMATION_TTL_MINUTES=30
# Comma-separated permissions granted to every fully verified user
AGENT_DEFAULT_PERMISSIONS=utility:read

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Optional allowed CORS origins (comma-separated, e.g. https://dashboard.yourdomain.com)
CORS_ALLOWED_ORIGINS=
